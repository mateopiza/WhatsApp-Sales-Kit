# ─────────────────────────────────────────────────────────────────────────────
# Empires Jewelry — Variables de Entorno para Docker Compose & Dokploy
# ─────────────────────────────────────────────────────────────────────────────

# Dominio público para Traefik / Dokploy (Ej. joyeria.tudominio.com)
DOMAIN=empires.example.com

# Puerto de mapeo en host (si se ejecuta directamente con docker compose)
STORE_PORT=3000

# Nombre de la tienda
STORE_NAME=Empires Jewelry

# Moneda base (USD, COP, EUR)
STORE_CURRENCY=USD

# Teléfono de WhatsApp para atención y cotizaciones (código de país + número, sin + ni guiones)
STORE_WHATSAPP_PHONE=573001234567

# Colores de identidad de marca (paleta Empires)
STORE_PRIMARY_COLOR=#D4B48C
STORE_ACCENT_COLOR=#3A332D

# PIN de Acceso al Portal de Administración CMS (/admin o 5 toques en el logo)
STORE_ADMIN_PIN=1879

# URL del logo personalizado (opcional)
STORE_LOGO_URL=

# Eslogan / Tagline
STORE_TAGLINE=Joyería de Alta Distinción
