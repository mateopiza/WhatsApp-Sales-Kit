# STORE_NAME — Display name shown in the browser tab and all UI headers
STORE_NAME=My Store

# STORE_CURRENCY — ISO 4217 currency code: USD | COP | MXN | EUR | etc.
STORE_CURRENCY=USD

# STORE_WHATSAPP_PHONE — Full international WhatsApp number for sales CTA
# Format: country code + number, digits only (no + or spaces)
STORE_WHATSAPP_PHONE=573001234567

# STORE_PRIMARY_COLOR — Primary brand color (hex)
STORE_PRIMARY_COLOR=#111111

# STORE_ACCENT_COLOR — Accent / contrast color (hex)
STORE_ACCENT_COLOR=#818CF8

# STORE_ADMIN_PIN — PIN or password for the /admin panel
STORE_ADMIN_PIN=1879

# STORE_LOGO_URL — Full URL to your brand logo image (optional, leave empty for text logo)
STORE_LOGO_URL=

# STORE_TAGLINE — Short brand tagline shown below the store name
STORE_TAGLINE=Powered by WhatsApp Sales Kit

# STORE_PORT — Host port the store will be available on (default: 3000)
STORE_PORT=3000

# COMPOSE_PROJECT_NAME — Prefix for container names (useful for multi-store VPS)
COMPOSE_PROJECT_NAME=store
