# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Sales Kit — Variables de Entorno para Docker Compose & Dokploy
#
# Copia este archivo a .env y ajústalo a tu negocio. Estas variables
# configuran la tienda en runtime (sin recompilar) vía docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# Qué template construye el docker-compose raíz: jewelry | blank
# (clothing es una demo frontend-only sin Dockerfile propio)
STORE_TEMPLATE=jewelry

# Dominio público para Traefik / Dokploy (Ej. mitienda.tudominio.com)
DOMAIN=store.example.com

# Puerto de mapeo en host (si se ejecuta directamente con docker compose)
STORE_PORT=3000

# Nombre de la tienda
STORE_NAME=My Store

# Moneda base (USD, COP, EUR, MXN...)
STORE_CURRENCY=USD

# Teléfono de WhatsApp para atención y cotizaciones (código de país + número, sin + ni guiones)
STORE_WHATSAPP_PHONE=573001234567

# Colores de identidad de marca
STORE_PRIMARY_COLOR=#111111
STORE_ACCENT_COLOR=#4F46E5

# PIN de Acceso al Portal de Administración CMS (/admin o 5 toques en el logo)
STORE_ADMIN_PIN=1879

# URL del logo personalizado (opcional)
STORE_LOGO_URL=

# Eslogan / Tagline
STORE_TAGLINE=Powered by WhatsApp Sales Kit
